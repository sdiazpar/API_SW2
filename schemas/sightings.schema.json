{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sighting",
    "type": "object",
    "required": ["datetime", "shape", "duration (seconds)", "comments", "date_posted", "latitude", "longitude", "user_email"],
    "properties": {
      "id": {
        "type": "string"
      },
      "datetime": {
        "type": "string",
        "format": "date-time"
      },
      "shape": {
        "type": "string"
      },
      "duration (seconds)": {
        "type": "integer"
      },
      "comments": {
        "type": "string"
      },
      "date_posted": {
        "type": "string",
        "format": "date-time"
      },
      "latitude": {
        "type": "string"
      },
      "longitude": {
        "type": "string"
      },
      "user_email": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }