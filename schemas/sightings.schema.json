{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sighting",
    "type": "object",
    "required": ["datetime", "shape", "duration (seconds)", "comments", "date posted", "latitude", "longitude", "user_id"],
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "datetime": {
        "type": "string",
        "format": "date-time"
      },
      "shape": {
        "type": "string"
      },
      "duration (seconds)": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "comments": {
        "type": "string"
      },
      "date posted": {
        "type": "string",
        "pattern": "^\\d{2}/\\d{2}/\\d{4}$"
      },
      "latitude": {
        "type": "string",
        "pattern": "^-?[0-9]+\\.?[0-9]*$"
      },
      "longitude": {
        "type": "string",
        "pattern": "^-?[0-9]+\\.?[0-9]*$"
      },
      "user_id": {
        "bsonType": "objectId"
      }
    },
    "additionalProperties": false
  }